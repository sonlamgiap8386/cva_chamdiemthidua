{
  "name": "cva-chamdiemthidua",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting,firestore:rules",
    "migrate:accounts": "node scripts/migrate-legacy-accounts.mjs",
    "reset:passwords": "node scripts/reset-user-passwords.mjs --apply",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test:rules-contract": "node --test tests/firestore-rules.contract.test.mjs",
    "test:rules": "npx firebase-tools emulators:exec --only firestore --project demo-cva \"node --test tests/firestore-rules.emulator.test.mjs\"",
    "sync:claims": "node scripts/sync-claims.mjs",
    "test": "npm run lint && npm run test:rules-contract && npm run test:unit",
    "test:unit": "node --test tests/rankings.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "firebase-admin": "^14.4.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
